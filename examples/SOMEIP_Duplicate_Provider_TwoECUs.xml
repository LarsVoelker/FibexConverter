<?xml version="1.0" encoding="UTF-8"?>
<!--
    The same service instance provided by TWO DIFFERENT ECUs.

    ECU_PROVIDER_A (UDP:30000) and ECU_PROVIDER_B (UDP:30001) BOTH provide the
    SAME service instance (PSI_ECHO_A / PSI_ECHO_B -> SVC_ECHO, instance 1),
    each on its own application endpoint (socket) on its own ECU.

    This is SUPPORTED: because provider dedup is scoped per application endpoint
    (== per socket), the provider survives on BOTH sockets. FLYNC allows the same
    service instance offered on different sockets/ECUs (no variant management is
    supported yet). Only identical PSIs within the SAME endpoint would be treated
    as a (deduplicated) duplicate and are intentionally NOT represented here.
-->
<fx:FIBEX xmlns:fx="http://www.asam.net/xml/fbx"
          xmlns:ho="http://www.asam.net/xml"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:ethernet="http://www.asam.net/xml/fbx/ethernet"
          xmlns:service="http://www.asam.net/xml/fbx/services"
          xmlns:it="http://www.asam.net/xml/fbx/it"
          VERSION="4.1.2">

    <fx:PROJECT ID="PROJ_TWOECU">
        <ho:SHORT-NAME>SomeIPDuplicateProviderTwoEcusTest</ho:SHORT-NAME>
    </fx:PROJECT>

    <fx:ELEMENTS>

        <fx:CHANNELS>
            <fx:CHANNEL ID="CHAN_VLAN100" xsi:type="ethernet:CHANNEL-TYPE">
                <ho:SHORT-NAME>VLAN100</ho:SHORT-NAME>
                <ethernet:VIRTUAL-LAN ID="VLAN100">
                    <ho:SHORT-NAME>VLAN100</ho:SHORT-NAME>
                    <ethernet:VLAN-IDENTIFIER>100</ethernet:VLAN-IDENTIFIER>
                </ethernet:VIRTUAL-LAN>
            </fx:CHANNEL>
        </fx:CHANNELS>

        <fx:ECUS>

            <fx:ECU ID="ECU_PROVIDER_A">
                <ho:SHORT-NAME>ECU_PROVIDER_A</ho:SHORT-NAME>
                <fx:CONTROLLERS>
                    <fx:CONTROLLER ID="CTRL_PROVIDER_A">
                        <ho:SHORT-NAME>Provider_Ctrl_A</ho:SHORT-NAME>
                    </fx:CONTROLLER>
                </fx:CONTROLLERS>
                <fx:CONNECTORS>
                    <fx:CONNECTOR ID="CONN_PROVIDER_A" xsi:type="it:CONNECTOR-TYPE">
                        <fx:CHANNEL-REF ID-REF="CHAN_VLAN100"/>
                        <fx:CONTROLLER-REF ID-REF="CTRL_PROVIDER_A"/>

                        <it:NETWORK-ENDPOINTS>
                            <it:NETWORK-ENDPOINT ID="NEP_PROVIDER_A">
                                <ho:SHORT-NAME>Provider_NEP_A</ho:SHORT-NAME>
                                <it:NETWORK-ENDPOINT-ADDRESSES>
                                    <it:NETWORK-ENDPOINT-ADDRESS>
                                        <it:IPV4>
                                            <it:IP-ADDRESS>192.168.1.1</it:IP-ADDRESS>
                                            <it:IPV4-ADDRESS-SOURCE>FIXED</it:IPV4-ADDRESS-SOURCE>
                                            <it:NETWORKMASK>255.255.255.0</it:NETWORKMASK>
                                        </it:IPV4>
                                    </it:NETWORK-ENDPOINT-ADDRESS>
                                </it:NETWORK-ENDPOINT-ADDRESSES>
                            </it:NETWORK-ENDPOINT>
                        </it:NETWORK-ENDPOINTS>

                        <it:APPLICATION-ENDPOINTS>
                            <it:APPLICATION-ENDPOINT ID="AEP_PROVIDER_A">
                                <ho:SHORT-NAME>Provider_AEP_A</ho:SHORT-NAME>
                                <it:IT-TRANSPORT-PROTOCOL-CONFIGURATION>
                                    <it:UDP-TP>
                                        <it:UDP-PORT>
                                            <it:PORT-NUMBER>30000</it:PORT-NUMBER>
                                        </it:UDP-PORT>
                                    </it:UDP-TP>
                                </it:IT-TRANSPORT-PROTOCOL-CONFIGURATION>
                                <it:NETWORK-ENDPOINT-REF ID-REF="NEP_PROVIDER_A"/>
                                <it:PROVIDED-SERVICE-INSTANCES>
                                    <it:PROVIDED-SERVICE-INSTANCE ID="PSI_ECHO_A">
                                        <it:INSTANCE-IDENTIFIER>1</it:INSTANCE-IDENTIFIER>
                                        <service:SERVICE-INTERFACE-REF ID-REF="SVC_ECHO"/>
                                    </it:PROVIDED-SERVICE-INSTANCE>
                                </it:PROVIDED-SERVICE-INSTANCES>
                            </it:APPLICATION-ENDPOINT>
                        </it:APPLICATION-ENDPOINTS>

                    </fx:CONNECTOR>
                </fx:CONNECTORS>
            </fx:ECU>

            <fx:ECU ID="ECU_PROVIDER_B">
                <ho:SHORT-NAME>ECU_PROVIDER_B</ho:SHORT-NAME>
                <fx:CONTROLLERS>
                    <fx:CONTROLLER ID="CTRL_PROVIDER_B">
                        <ho:SHORT-NAME>Provider_Ctrl_B</ho:SHORT-NAME>
                    </fx:CONTROLLER>
                </fx:CONTROLLERS>
                <fx:CONNECTORS>
                    <fx:CONNECTOR ID="CONN_PROVIDER_B" xsi:type="it:CONNECTOR-TYPE">
                        <fx:CHANNEL-REF ID-REF="CHAN_VLAN100"/>
                        <fx:CONTROLLER-REF ID-REF="CTRL_PROVIDER_B"/>

                        <it:NETWORK-ENDPOINTS>
                            <it:NETWORK-ENDPOINT ID="NEP_PROVIDER_B">
                                <ho:SHORT-NAME>Provider_NEP_B</ho:SHORT-NAME>
                                <it:NETWORK-ENDPOINT-ADDRESSES>
                                    <it:NETWORK-ENDPOINT-ADDRESS>
                                        <it:IPV4>
                                            <it:IP-ADDRESS>192.168.1.2</it:IP-ADDRESS>
                                            <it:IPV4-ADDRESS-SOURCE>FIXED</it:IPV4-ADDRESS-SOURCE>
                                            <it:NETWORKMASK>255.255.255.0</it:NETWORKMASK>
                                        </it:IPV4>
                                    </it:NETWORK-ENDPOINT-ADDRESS>
                                </it:NETWORK-ENDPOINT-ADDRESSES>
                            </it:NETWORK-ENDPOINT>
                        </it:NETWORK-ENDPOINTS>

                        <it:APPLICATION-ENDPOINTS>
                            <it:APPLICATION-ENDPOINT ID="AEP_PROVIDER_B">
                                <ho:SHORT-NAME>Provider_AEP_B</ho:SHORT-NAME>
                                <it:IT-TRANSPORT-PROTOCOL-CONFIGURATION>
                                    <it:UDP-TP>
                                        <it:UDP-PORT>
                                            <it:PORT-NUMBER>30001</it:PORT-NUMBER>
                                        </it:UDP-PORT>
                                    </it:UDP-TP>
                                </it:IT-TRANSPORT-PROTOCOL-CONFIGURATION>
                                <it:NETWORK-ENDPOINT-REF ID-REF="NEP_PROVIDER_B"/>
                                <it:PROVIDED-SERVICE-INSTANCES>
                                    <it:PROVIDED-SERVICE-INSTANCE ID="PSI_ECHO_B">
                                        <it:INSTANCE-IDENTIFIER>1</it:INSTANCE-IDENTIFIER>
                                        <service:SERVICE-INTERFACE-REF ID-REF="SVC_ECHO"/>
                                    </it:PROVIDED-SERVICE-INSTANCE>
                                </it:PROVIDED-SERVICE-INSTANCES>
                            </it:APPLICATION-ENDPOINT>
                        </it:APPLICATION-ENDPOINTS>

                    </fx:CONNECTOR>
                </fx:CONNECTORS>
            </fx:ECU>

        </fx:ECUS>

        <fx:SERVICE-INTERFACES>
            <fx:SERVICE-INTERFACE ID="SVC_ECHO" xsi:type="service:SERVICE-INTERFACE-TYPE">
                <ho:SHORT-NAME>SVC_ECHO</ho:SHORT-NAME>
                <fx:SERVICE-IDENTIFIER>4660</fx:SERVICE-IDENTIFIER>
                <service:API-VERSION>
                    <service:MAJOR>1</service:MAJOR>
                    <service:MINOR>0</service:MINOR>
                </service:API-VERSION>
            </fx:SERVICE-INTERFACE>
        </fx:SERVICE-INTERFACES>

    </fx:ELEMENTS>

</fx:FIBEX>
