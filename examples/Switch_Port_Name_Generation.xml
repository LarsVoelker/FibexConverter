<?xml version="1.0" encoding="UTF-8"?>
<!--
    Topology-only example exercising switch port name generation
    (configuration_to_text / configuration_to_flync flag: generate-switch-port-names).

    Layout:

        ECU_A ── Switch_A ── Switch_B
                    │
                    └────── Switch_C

    ECU_A:
      - one controller (CTRL_ECU_A), no switch, single connector/port.

    ECU_B (hosts three switches; one minimal management controller is declared
    so the FLYNC converter has an interface to attach. It is intentionally not
    wired to any switch port):
      - Switch_A: port_external_a → ECU_A's controller
                  port_sw_b      → Switch_B.port_sw_a
                  port_sw_c      → Switch_C.port_sw_a
      - Switch_B: port_sw_a      → Switch_A.port_sw_b
      - Switch_C: port_sw_a      → Switch_A.port_sw_c
-->
<fx:FIBEX xmlns:fx="http://www.asam.net/xml/fbx"
          xmlns:ho="http://www.asam.net/xml"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:ethernet="http://www.asam.net/xml/fbx/ethernet"
          xmlns:it="http://www.asam.net/xml/fbx/it"
          VERSION="4.1.2">

    <fx:PROJECT ID="PROJ_SWITCH_PORTNAME">
        <ho:SHORT-NAME>SwitchPortNameGeneration</ho:SHORT-NAME>
    </fx:PROJECT>

    <fx:ELEMENTS>

        <fx:CHANNELS>
            <fx:CHANNEL ID="CHAN_VLAN10" xsi:type="ethernet:CHANNEL-TYPE">
                <ho:SHORT-NAME>VLAN10</ho:SHORT-NAME>
                <ethernet:VIRTUAL-LAN ID="VLAN10">
                    <ho:SHORT-NAME>VLAN10</ho:SHORT-NAME>
                    <ethernet:VLAN-IDENTIFIER>10</ethernet:VLAN-IDENTIFIER>
                </ethernet:VIRTUAL-LAN>
            </fx:CHANNEL>
        </fx:CHANNELS>

        <fx:COUPLING-ELEMENTS>

            <!-- Switch_A on ECU_B -->
            <fx:COUPLING-ELEMENT ID="CE_SWITCH_A" xsi:type="ethernet:COUPLING-ELEMENT-TYPE">
                <ho:SHORT-NAME>Switch_A</ho:SHORT-NAME>
                <fx:CLUSTER-REF ID-REF="CLUSTER_ETH"/>
                <fx:ECU-REF ID-REF="ECU_B"/>
                <fx:COUPLING-PORTS>

                    <fx:COUPLING-PORT ID="SWA_port_external_a" xsi:type="ethernet:COUPLING-PORT-TYPE">
                        <fx:CONTROLLER-REF ID-REF="CTRL_ECU_A"/>
                        <ethernet:VLAN-MEMBERSHIPS>
                            <ethernet:VLAN-MEMBERSHIP>
                                <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                                <ethernet:DEFAULT-PRIORITY>
                                    <fx:PRIORITY>0</fx:PRIORITY>
                                </ethernet:DEFAULT-PRIORITY>
                            </ethernet:VLAN-MEMBERSHIP>
                        </ethernet:VLAN-MEMBERSHIPS>
                        <ethernet:DEFAULT-VLAN>
                            <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                        </ethernet:DEFAULT-VLAN>
                    </fx:COUPLING-PORT>

                    <fx:COUPLING-PORT ID="SWA_port_sw_b" xsi:type="ethernet:COUPLING-PORT-TYPE">
                        <fx:COUPLING-PORT-REF ID-REF="SWB_port_sw_a"/>
                        <ethernet:VLAN-MEMBERSHIPS>
                            <ethernet:VLAN-MEMBERSHIP>
                                <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                                <ethernet:DEFAULT-PRIORITY>
                                    <fx:PRIORITY>0</fx:PRIORITY>
                                </ethernet:DEFAULT-PRIORITY>
                            </ethernet:VLAN-MEMBERSHIP>
                        </ethernet:VLAN-MEMBERSHIPS>
                        <ethernet:DEFAULT-VLAN>
                            <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                        </ethernet:DEFAULT-VLAN>
                    </fx:COUPLING-PORT>

                    <fx:COUPLING-PORT ID="SWA_port_sw_c" xsi:type="ethernet:COUPLING-PORT-TYPE">
                        <fx:COUPLING-PORT-REF ID-REF="SWC_port_sw_a"/>
                        <ethernet:VLAN-MEMBERSHIPS>
                            <ethernet:VLAN-MEMBERSHIP>
                                <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                                <ethernet:DEFAULT-PRIORITY>
                                    <fx:PRIORITY>0</fx:PRIORITY>
                                </ethernet:DEFAULT-PRIORITY>
                            </ethernet:VLAN-MEMBERSHIP>
                        </ethernet:VLAN-MEMBERSHIPS>
                        <ethernet:DEFAULT-VLAN>
                            <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                        </ethernet:DEFAULT-VLAN>
                    </fx:COUPLING-PORT>

                </fx:COUPLING-PORTS>
                <ethernet:COUPLING-ELEMENT-TYPE>SWITCH</ethernet:COUPLING-ELEMENT-TYPE>
            </fx:COUPLING-ELEMENT>

            <!-- Switch_B on ECU_B -->
            <fx:COUPLING-ELEMENT ID="CE_SWITCH_B" xsi:type="ethernet:COUPLING-ELEMENT-TYPE">
                <ho:SHORT-NAME>Switch_B</ho:SHORT-NAME>
                <fx:CLUSTER-REF ID-REF="CLUSTER_ETH"/>
                <fx:ECU-REF ID-REF="ECU_B"/>
                <fx:COUPLING-PORTS>

                    <fx:COUPLING-PORT ID="SWB_port_sw_a" xsi:type="ethernet:COUPLING-PORT-TYPE">
                        <fx:COUPLING-PORT-REF ID-REF="SWA_port_sw_b"/>
                        <ethernet:VLAN-MEMBERSHIPS>
                            <ethernet:VLAN-MEMBERSHIP>
                                <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                                <ethernet:DEFAULT-PRIORITY>
                                    <fx:PRIORITY>0</fx:PRIORITY>
                                </ethernet:DEFAULT-PRIORITY>
                            </ethernet:VLAN-MEMBERSHIP>
                        </ethernet:VLAN-MEMBERSHIPS>
                        <ethernet:DEFAULT-VLAN>
                            <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                        </ethernet:DEFAULT-VLAN>
                    </fx:COUPLING-PORT>

                </fx:COUPLING-PORTS>
                <ethernet:COUPLING-ELEMENT-TYPE>SWITCH</ethernet:COUPLING-ELEMENT-TYPE>
            </fx:COUPLING-ELEMENT>

            <!-- Switch_C on ECU_B -->
            <fx:COUPLING-ELEMENT ID="CE_SWITCH_C" xsi:type="ethernet:COUPLING-ELEMENT-TYPE">
                <ho:SHORT-NAME>Switch_C</ho:SHORT-NAME>
                <fx:CLUSTER-REF ID-REF="CLUSTER_ETH"/>
                <fx:ECU-REF ID-REF="ECU_B"/>
                <fx:COUPLING-PORTS>

                    <fx:COUPLING-PORT ID="SWC_port_sw_a" xsi:type="ethernet:COUPLING-PORT-TYPE">
                        <fx:COUPLING-PORT-REF ID-REF="SWA_port_sw_c"/>
                        <ethernet:VLAN-MEMBERSHIPS>
                            <ethernet:VLAN-MEMBERSHIP>
                                <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                                <ethernet:DEFAULT-PRIORITY>
                                    <fx:PRIORITY>0</fx:PRIORITY>
                                </ethernet:DEFAULT-PRIORITY>
                            </ethernet:VLAN-MEMBERSHIP>
                        </ethernet:VLAN-MEMBERSHIPS>
                        <ethernet:DEFAULT-VLAN>
                            <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                        </ethernet:DEFAULT-VLAN>
                    </fx:COUPLING-PORT>

                </fx:COUPLING-PORTS>
                <ethernet:COUPLING-ELEMENT-TYPE>SWITCH</ethernet:COUPLING-ELEMENT-TYPE>
            </fx:COUPLING-ELEMENT>

        </fx:COUPLING-ELEMENTS>

        <fx:ECUS>

            <!-- ECU_A: single controller, no switch, single port -->
            <fx:ECU ID="ECU_A">
                <ho:SHORT-NAME>ECU_A</ho:SHORT-NAME>
                <fx:CONTROLLERS>
                    <fx:CONTROLLER ID="CTRL_ECU_A">
                        <ho:SHORT-NAME>ECU_A_Ctrl</ho:SHORT-NAME>
                    </fx:CONTROLLER>
                </fx:CONTROLLERS>
                <fx:CONNECTORS>
                    <fx:CONNECTOR ID="CONN_ECU_A" xsi:type="it:CONNECTOR-TYPE">
                        <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                        <fx:CONTROLLER-REF ID-REF="CTRL_ECU_A"/>
                        <it:NETWORK-ENDPOINTS>
                            <it:NETWORK-ENDPOINT ID="NEP_ECU_A">
                                <ho:SHORT-NAME>ECU_A_NEP</ho:SHORT-NAME>
                                <it:NETWORK-ENDPOINT-ADDRESSES>
                                    <it:NETWORK-ENDPOINT-ADDRESS>
                                        <it:IPV4>
                                            <it:IP-ADDRESS>192.168.10.1</it:IP-ADDRESS>
                                            <it:IPV4-ADDRESS-SOURCE>FIXED</it:IPV4-ADDRESS-SOURCE>
                                            <it:NETWORKMASK>255.255.255.0</it:NETWORKMASK>
                                        </it:IPV4>
                                    </it:NETWORK-ENDPOINT-ADDRESS>
                                </it:NETWORK-ENDPOINT-ADDRESSES>
                            </it:NETWORK-ENDPOINT>
                        </it:NETWORK-ENDPOINTS>
                    </fx:CONNECTOR>
                </fx:CONNECTORS>
            </fx:ECU>

            <!-- ECU_B: hosts Switch_A, Switch_B and Switch_C.
                 A single management controller is declared so the FLYNC
                 converter has an interface to attach. It is intentionally
                 not wired to any switch port. -->
            <fx:ECU ID="ECU_B">
                <ho:SHORT-NAME>ECU_B</ho:SHORT-NAME>
                <fx:CONTROLLERS>
                    <fx:CONTROLLER ID="CTRL_ECU_B_MGMT">
                        <ho:SHORT-NAME>ECU_B_Mgmt</ho:SHORT-NAME>
                    </fx:CONTROLLER>
                </fx:CONTROLLERS>
                <fx:CONNECTORS>
                    <fx:CONNECTOR ID="CONN_ECU_B_MGMT" xsi:type="it:CONNECTOR-TYPE">
                        <fx:CHANNEL-REF ID-REF="CHAN_VLAN10"/>
                        <fx:CONTROLLER-REF ID-REF="CTRL_ECU_B_MGMT"/>
                    </fx:CONNECTOR>
                </fx:CONNECTORS>
            </fx:ECU>

        </fx:ECUS>

    </fx:ELEMENTS>

</fx:FIBEX>
